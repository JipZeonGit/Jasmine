# ---- Stage 1: Maven 构建 ----
# 构建阶段仍用 HotSpot JDK（Maven 兼容性最佳）
FROM eclipse-temurin:21-jdk AS builder

WORKDIR /app

COPY mvnw mvnw.cmd ./
COPY .mvn .mvn
COPY pom.xml ./

RUN chmod +x ./mvnw && ./mvnw dependency:go-offline -B

COPY src src
RUN ./mvnw -DskipTests package -B

# ---- Stage 2: OpenJ9 极致省内存运行镜像 ----
# IBM Semeru = OpenJ9 JVM + OpenJDK class library，内存占用通常比 HotSpot 低 30-60%
FROM icr.io/appcafe/ibm-semeru-runtimes:open-21-jre-jammy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/Jasmine-0.0.1-SNAPSHOT.jar /app/jasmine.jar

EXPOSE 9999

# OpenJ9 内存与 GC 优化：
#   -Xgcpolicy:gencon      : 分代并发收集器，OpenJ9 默认策略，兼顾吞吐和延迟
#   -XX:MaxRAMPercentage   : 按容器内存上限百分比自动计算堆大小
#   -Xtune:virtualized     : 虚拟化/容器环境调优，减少线程栈和 JIT 代码缓存的默认大小
#   -Xshareclasses         : 共享类缓存，加速启动、减少运行时内存
#   -Xquickstart           : 牺牲少量峰值吞吐换取更快启动（适合微服务/短生命周期容器）
#   -XX:+UseContainerSupport: 确保正确识别 cgroup 限制
ENTRYPOINT ["java", \
  "-Xgcpolicy:gencon", \
  "-XX:MaxRAMPercentage=70.0", \
  "-XX:InitialRAMPercentage=40.0", \
  "-Xtune:virtualized", \
  "-Xshareclasses:cacheDir=/app/.shareclasses", \
  "-Xquickstart", \
  "-XX:+UseContainerSupport", \
  "-jar", "/app/jasmine.jar"]
