# ---- Stage 1: Maven 构建 ----
# 构建阶段仍用 HotSpot JDK（Maven 兼容性最佳）
FROM eclipse-temurin:21-jdk AS builder

WORKDIR /app

COPY mvnw mvnw.cmd ./
COPY .mvn .mvn
COPY pom.xml ./

RUN chmod +x ./mvnw && ./mvnw dependency:go-offline -B

COPY src src
RUN ./mvnw -DskipTests package -B

# ---- Stage 2: OpenJ9 极致省内存运行镜像 ----
# IBM Semeru = OpenJ9 JVM + OpenJDK class library，内存占用通常比 HotSpot 低 30-60%
FROM icr.io/appcafe/ibm-semeru-runtimes:open-21-jre-jammy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/Jasmine-0.0.1-SNAPSHOT.jar /app/jasmine.jar

EXPOSE 9999

# OpenJ9 内存与 GC 优化：
#   -Xgcpolicy:gencon      : 分代并发收集器，OpenJ9 默认策略，兼顾吞吐和延迟
#   -Xms/-Xmx              : 固定堆大小，避免依赖 cgroup 检测（部分环境 mem_limit 未生效时
#                             百分比参数会按宿主机内存计算，导致堆远超预期）
#   -Xtune:virtualized     : 虚拟化/容器环境调优，减少线程栈和 JIT 代码缓存的默认大小
#   -Xshareclasses         : 共享类缓存，加速启动、减少运行时内存
#   -Xscmx                 : 限制共享类缓存上限，避免 SCC 无限膨胀占用过多内存
#   -Xquickstart           : 牺牲少量峰值吞吐换取更快启动（适合微服务/短生命周期容器）
ENTRYPOINT ["java", \
  "-Xgcpolicy:gencon", \
  "-Xms256m", \
  "-Xmx384m", \
  "-Xtune:virtualized", \
  "-Xshareclasses:cacheDir=/app/.shareclasses", \
  "-Xscmx48m", \
  "-Xquickstart", \
  "-jar", "/app/jasmine.jar"]
