# ========================================
# Jasmine Docker 环境变量配置文件（示例模板）
# ========================================
# 使用方法：复制本文件为 .env，然后修改下面的值为您的实际配置
# cp .env.example .env
#
# 注意：.env 文件包含敏感密码信息，已被 .gitignore 排除，不会被提交到 Git 仓库

# MySQL 配置
MYSQL_ROOT_PASSWORD=请修改为您的MySQL根密码（仅运维使用，应用不会用到）
MYSQL_DATABASE=jasmine
# 应用专用连接用户（非 root，由 MySQL 容器首次启动时自动创建，并授予 jasmine 库的全部权限）
MYSQL_USER=jasmine_app
MYSQL_PASSWORD=请修改为您的MySQL应用用户密码

# Redis 配置
REDIS_PASSWORD=请修改为您的Redis密码

# CORS 跨域白名单（多个地址用逗号分隔）
# 默认放行 localhost:8888（本地调试）和 localhost（Docker Nginx 80端口）
# 如果前端部署在其他端口或域名，请修改此项
# CORS_ALLOWED_ORIGINS=http://localhost:8888,http://localhost
