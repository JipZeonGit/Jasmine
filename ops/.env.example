# ==============================================================================
# Jasmine 环境变量示例
# 复制为 .env 后根据实际环境修改，所有 change-me-* 占位符必须替换
# ==============================================================================

# ---- Compose ----
COMPOSE_PROJECT_NAME=jasmine

# ---- 镜像（仅 prod compose 使用，dev compose 本地构建无需配置） ----
# 微服务后端镜像，每个独立打包推送到 GHCR
SCHEMA_IMAGE=ghcr.io/jipzeongit/jasmine-schema
SCHEMA_IMAGE_TAG=microservices-latest
GATEWAY_IMAGE=ghcr.io/jipzeongit/jasmine-gateway
GATEWAY_IMAGE_TAG=microservices-latest
IAM_IMAGE=ghcr.io/jipzeongit/jasmine-iam
IAM_IMAGE_TAG=microservices-latest
PRODUCT_IMAGE=ghcr.io/jipzeongit/jasmine-product
PRODUCT_IMAGE_TAG=microservices-latest
TRADE_IMAGE=ghcr.io/jipzeongit/jasmine-trade
TRADE_IMAGE_TAG=microservices-latest
CRM_IMAGE=ghcr.io/jipzeongit/jasmine-crm
CRM_IMAGE_TAG=microservices-latest
FRONTEND_IMAGE=ghcr.io/jipzeongit/jasmine-frontend
FRONTEND_IMAGE_TAG=microservices-latest

# ---- 后端应用 ----
SPRING_PROFILES_ACTIVE=prod
APP_MQ_ENABLED=true
APP_CACHE_TYPE=redis
JWT_SECRET=change-me-before-deploy
CORS_ALLOWED_ORIGINS=http://localhost:8888,http://localhost:5173,http://127.0.0.1:5173,http://localhost

# JWT 高级配置（均有内置默认值，按需取消注释覆盖）
# JWT_EXPIRE_MILLIS=1800000
# JWT_REFRESH_EXPIRE_MILLIS=604800000
# JWT_REFRESH_COOKIE_NAME=jasmine_refresh_token
# JWT_REFRESH_COOKIE_SECURE=true
# JWT_REFRESH_COOKIE_SAME_SITE=Lax

# MQ 高级配置（均有内置默认值，按需取消注释覆盖）
# APP_MQ_DLX_ENABLED=true
# APP_MQ_IDEMPOTENCY_TTL_HOURS=24
# APP_MQ_RETRY_MAX_ATTEMPTS=3
# APP_MQ_RETRY_INITIAL_INTERVAL_MS=1000
# APP_MQ_RETRY_MULTIPLIER=2.0
# APP_MQ_RETRY_MAX_INTERVAL_MS=10000

# 幂等 & Outbox 配置（均有内置默认值，按需取消注释覆盖）
# APP_CREATE_IDEMPOTENCY_TTL_SECONDS=30
# APP_OUTBOX_RELAY_INTERVAL_MS=5000
# APP_OUTBOX_RELAY_BATCH_SIZE=50

# ---- 端口映射 ----
# dev compose 默认: 后端 9999 / 前端 8888 / MySQL 13306 / Redis 6379 / RMQ 5673+15673
# prod compose 默认: 后端 9999 / 前端 80 / MySQL 3306 / Redis 6379 / RMQ 5672+15672
BACKEND_PORT=9999
FRONTEND_PORT=8888

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jasmine
MYSQL_USER=jasmine_app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=13306

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USERNAME=jasmine
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/jasmine
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# ---- Nacos ----
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_NAMESPACE=dev
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos
# 生产环境务必替换为随机 Base64 字符串（>= 32 字节）
NACOS_AUTH_TOKEN=SecretToken012345678901234567890123456789012345678901234567890123456789
