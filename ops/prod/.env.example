# ==============================================================================
# Jasmine 微服务生产环境专属环境变量模板 (ops/prod/.env.example)
#
# 操作步骤:
#   1. 将本文件复制为 ops/.env:  cp ops/prod/.env.example ops/.env
#   2. 修改下面的各组件密码（带 change-me- 前缀的项）
#   3. 根据本文件顶部的密钥生成指南，生成您专属的 JWT_SECRET 与 NACOS_AUTH_TOKEN
#   4. 运行部署脚本:  ./ops/prod/up.sh
# ==============================================================================

# ---- Compose 配置 ----
COMPOSE_PROJECT_NAME=jasmine-prod

# ---- 镜像 Tag (动态 Tag，支持多架构 linux/amd64 与 linux/arm64) ----
SCHEMA_IMAGE=ghcr.io/jipzeongit/jasmine-schema
SCHEMA_IMAGE_TAG=microservices-latest

GATEWAY_IMAGE=ghcr.io/jipzeongit/jasmine-gateway
GATEWAY_IMAGE_TAG=microservices-latest

IAM_IMAGE=ghcr.io/jipzeongit/jasmine-iam
IAM_IMAGE_TAG=microservices-latest

PRODUCT_IMAGE=ghcr.io/jipzeongit/jasmine-product
PRODUCT_IMAGE_TAG=microservices-latest

TRADE_IMAGE=ghcr.io/jipzeongit/jasmine-trade
TRADE_IMAGE_TAG=microservices-latest

CRM_IMAGE=ghcr.io/jipzeongit/jasmine-crm
CRM_IMAGE_TAG=microservices-latest

FRONTEND_IMAGE=ghcr.io/jipzeongit/jasmine-frontend
FRONTEND_IMAGE_TAG=microservices-latest


# ---- 后端核心配置 ----
SPRING_PROFILES_ACTIVE=prod
APP_MQ_ENABLED=true
APP_CACHE_TYPE=redis

# ==============================================================================
# 【安全核心】安全密钥生成与配置
# ==============================================================================

# 1. JWT 签名密钥 (JWT_SECRET)
# ------------------------------------------------------------------------------
# 规范：HS512 签名算法要求密钥长度不低于 512-bit (即 64 字节)
# 推荐的密钥生成命令 (在任意终端执行均可生成强随机安全的 Base64 格式字符串):
#   - 方式 A (推荐, 跨平台 OpenSSL):
#       openssl rand -base64 64
#   - 方式 B (Python3):
#       python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   - 方式 C (Node.js):
#       node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# ------------------------------------------------------------------------------
# 下面是由 `openssl rand -base64 64` 预生成的安全示例密钥（部署时建议用您自己生成的字符串替换）：
JWT_SECRET=Rzh3aDdyU3M5bTFYNHZBRUpLbE1uT3BRc3RVVldYWlphYmNkZWZnaGk3ODlBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWjAxMjM0NTY3ODk9PQ==

# 2. Nacos 服务端安全 Token (NACOS_AUTH_TOKEN)
# ------------------------------------------------------------------------------
# 规范：Nacos 2.x 鉴权开启时，要求密钥必须是 Base64 格式的随机串，且原始长度不低于 32 字节
# 推荐的密钥生成命令:
#   - 方式 A (OpenSSL):
#       openssl rand -base64 32
#   - 方式 B (Python3):
#       python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
# 下面是由 `openssl rand -base64 32` 预生成的安全示例密钥：
NACOS_AUTH_TOKEN=VzE5Wk10TzhVemFYcUtKdVl4TnBDd1ZSZ0RMRm9iM1c=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=jasmineSecurityIdentity2026


# ---- 跨域安全设置 (CORS) ----
# 生产环境中，如果您的前端跑在 standard 80 / 443 端口，网关跑在 8080 端口，
# 浏览器发起跨域请求时会进行同源检查。请在此处列出您生产前端的公网访问地址（逗号分隔）。
# 【注意】开箱即用状态下默认允许本机及内网直接访问。如有独立域名，请务必追加：,https://jasmine.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1


# ==============================================================================
# ---- 生产标准端口映射 ----
# ==============================================================================
FRONTEND_PORT=80
GATEWAY_PORT=8080
BACKEND_PORT=9999

# ---- 中间件端口 ----
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_PORT=8848
NACOS_GRPC_PORT=9848


# ==============================================================================
# ---- 生产数据与中间件账号密码 ----
# ==============================================================================

# ---- Nacos 命名空间 ----
NACOS_NAMESPACE=prod
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos

# ---- MySQL 生产配置 ----
# 微服务启动时会自动通过 Flyway 进行数据库结构迁移。
# 容器初次拉起时会自动执行 init-databases.sql 创建 nacos 等 5 个生产级库。
MYSQL_DATABASE=jasmine
MYSQL_USER=jasmine_app
MYSQL_PASSWORD=change-me-app-mysql-pwd
MYSQL_ROOT_PASSWORD=change-me-root-mysql-pwd

# ---- Redis 生产配置 ----
REDIS_PASSWORD=change-me-redis-pwd

# ---- RabbitMQ 生产配置 ----
RABBITMQ_USERNAME=jasmine
RABBITMQ_PASSWORD=change-me-rabbitmq-pwd
RABBITMQ_VHOST=/jasmine


# ==============================================================================
# ---- 生产容器内存与资源硬性限制 ----
# ==============================================================================
# Jasmine 各微服务均基于 Java 21 + ZGC 运行，
# 配合 MaxRAMPercentage 参数，JVM 堆内存会根据容器物理内存限额自动缩放。
# 生产环境下限制单微服务物理内存最高 512M，预留保障 256M。
SERVICE_MEMORY_LIMIT=512m
SERVICE_MEMORY_RESERVATION=256m
