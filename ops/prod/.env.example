# ==============================================================================
# Jasmine 生产环境变量模板 (ops/prod/.env.example)
#
# 使用前:
#   1. 复制为 ops/prod/.env: cp ops/prod/.env.example ops/prod/.env
#   2. 替换所有 change-me-* 占位符为您自己的强密码
#   3. 按注释中的命令生成 JWT_SECRET / NACOS_AUTH_TOKEN / GATEWAY_SHARED_TOKEN
#   4. 运行部署: cd ops/prod && docker compose --env-file .env up -d
# ==============================================================================

# ---- Compose 配置 ----
COMPOSE_PROJECT_NAME=jasmine-prod

# ---- 镜像 Tag (支持 linux/amd64 与 linux/arm64 多架构) ----
SCHEMA_IMAGE=ghcr.io/jipzeongit/jasmine-schema
SCHEMA_IMAGE_TAG=microservices-latest

GATEWAY_IMAGE=ghcr.io/jipzeongit/jasmine-gateway
GATEWAY_IMAGE_TAG=microservices-latest

IAM_IMAGE=ghcr.io/jipzeongit/jasmine-iam
IAM_IMAGE_TAG=microservices-latest

PRODUCT_IMAGE=ghcr.io/jipzeongit/jasmine-product
PRODUCT_IMAGE_TAG=microservices-latest

TRADE_IMAGE=ghcr.io/jipzeongit/jasmine-trade
TRADE_IMAGE_TAG=microservices-latest

CRM_IMAGE=ghcr.io/jipzeongit/jasmine-crm
CRM_IMAGE_TAG=microservices-latest

FRONTEND_IMAGE=ghcr.io/jipzeongit/jasmine-frontend
FRONTEND_IMAGE_TAG=microservices-latest


# ---- 后端核心配置 ----
SPRING_PROFILES_ACTIVE=prod
APP_MQ_ENABLED=true
APP_CACHE_TYPE=redis

# ==============================================================================
# 【安全核心】密钥生成与配置
# ==============================================================================

# 1. JWT 签名密钥 (JWT_SECRET)
# ------------------------------------------------------------------------------
# 规范：HS512 签名算法要求密钥长度不低于 512-bit (即 64 字节)
# 推荐的密钥生成命令 (在任意终端执行均可生成强随机安全的 Base64 格式字符串):
#   - 方式 A (推荐, 跨平台 OpenSSL):
#       openssl rand -base64 64
#   - 方式 B (Python3):
#       python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   - 方式 C (Node.js):
#       node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# ------------------------------------------------------------------------------
# 下面是由 openssl rand -base64 64 预生成的安全示例密钥（部署时必须替换）：
JWT_SECRET=change-me-请用上方命令生成并替换此处

# 2. 网关与下游服务共享密钥 (GATEWAY_SHARED_TOKEN)
# ------------------------------------------------------------------------------
# 任意随机字符串即可，但必须与 Nacos 配置 jasmine-common.yml 中保持一致。
# 推荐生成命令:
#   openssl rand -hex 16
# ------------------------------------------------------------------------------
GATEWAY_SHARED_TOKEN=change-me-请用 openssl-rand-hex-16 生成并替换

# 3. Nacos 服务端安全 Token (NACOS_AUTH_TOKEN)
# ------------------------------------------------------------------------------
# 规范：Nacos 3.x 鉴权开启时，要求密钥必须是 Base64 格式的随机串，且原始长度 >= 32 字节。
# 推荐的密钥生成命令:
#   - 方式 A (OpenSSL):
#       openssl rand -base64 32
#   - 方式 B (Python3):
#       python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
# 下面是由 openssl rand -base64 32 预生成的安全示例密钥（部署时必须替换）：
NACOS_AUTH_TOKEN=change-me-请用上方命令生成并替换此处
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-your-identity-value


# ---- 跨域安全设置 (CORS) ----
# 生产环境中，如果您的前端跑在 standard 80 / 443 端口，网关跑在 8080 端口，
# 浏览器发起跨域请求时会进行同源检查。请在此处列出您生产前端的公网访问地址（逗号分隔）。
# 【注意】开箱即用默认允许本机及内网直接访问。如有独立域名，请务必追加：,https://jasmine.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1


# ---- 生产标准端口映射 ----
FRONTEND_PORT=80
GATEWAY_PORT=8080

# ---- 中间件端口 ----
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_PORT=8848
NACOS_GRPC_PORT=9848


# ---- Nacos 连接凭据 ----
# Nacos 控制台默认管理员账号为 nacos，首次部署时密码使用以下占位符；
# import.sh 自愈机制会自动将 Nacos 数据库中的密码同步为此处配置的值。
NACOS_NAMESPACE=prod
NACOS_USERNAME=nacos
# ⚠️ Nacos 3.x 登录 API 不支持含特殊字符的密码（如 + / % # @ ! = 等），
#    会导致 Nacos 返回 500 鉴权失败。密码请仅使用大小写字母和数字。
#    推荐生成命令: openssl rand -hex 16
NACOS_PASSWORD=change-me-请用 openssl-rand-hex-16 生成纯字母数字密码

# ---- MySQL ----
MYSQL_DATABASE=jasmine
MYSQL_USER=jasmine_app
MYSQL_PASSWORD=change-me-mysql-app-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password

# ---- RabbitMQ ----
RABBITMQ_USERNAME=jasmine
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=/jasmine


# ---- 生产容器内存与资源硬性限制 ----
SERVICE_MEMORY_LIMIT=512m
SERVICE_MEMORY_RESERVATION=256m
